# Réglages de l'appli Jabba. Copie ce fichier en .env et remplace les <…>.
# Le fichier .env reste sur le serveur : il n'est jamais publié.

# Qui a le droit d'utiliser l'appli : ton identifiant Tailscale
# (plusieurs possibles, séparés par des virgules).
TS_USERS=<ton identifiant Tailscale>

# Lien avec Nextcloud (écran Fichiers), si l'outil Nextcloud est utilisé
NC_USER=<ton nom d'utilisateur Nextcloud>
NC_APP_PASSWORD=<mot de passe d'application Nextcloud>
NC_URL=http://127.0.0.1:8081
NC_HOST=<nom-du-serveur>.<ton-tailnet>.ts.net
NC_PUBLIC_URL=https://nextcloud.<ton-tailnet>.ts.net

# Boutons « Ouvrir » de l'Établi
LIENS=nextcloud=https://nextcloud.<ton-tailnet>.ts.net,jellyfin=https://jellyfin.<ton-tailnet>.ts.net,dockge=https://dockge.<ton-tailnet>.ts.net

# Compte du serveur dont le mot de passe protège les actions admin
ADMIN_USER=<nom d'utilisateur sur le serveur>

# Disques déclarés à la main, toujours sous /srv/disques (les disques USB branchés ensuite sont ajoutés tout seuls)
DISQUES=<nom>=/srv/disques/<nom>

# Dépôt GitHub de l'appli, pour le bouton « Installer la mise à jour »
JABBA_DEPOT=<compte>/jabba

# Batterie (en %) sous laquelle le serveur s'éteint proprement pendant une coupure
SEUIL_BATTERIE=15
